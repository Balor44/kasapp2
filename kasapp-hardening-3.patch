index 0000000..916ce1a
--- /dev/null
+++ b/src/services/ops/store.ts
@@ -0,0 +1,63 @@
+import { OperationModel } from "../../models/Operation";
+import { OpKind, OpState, Operation, OpStore, TERMINAL } from "./types";
+
+const plain = (doc: any): Operation | null => (doc ? (doc.toObject ? doc.toObject() : doc) : null);
+
+/** MongoDB backed store. Every transition is a single atomic findOneAndUpdate guarded by state. */
+export const mongoOpStore: OpStore = {
+  async getOrCreate(key: string, kind: OpKind, params: Record<string, any>) {
+    const create = () =>
+      OperationModel.findOneAndUpdate(
+        { key },
+        { $setOnInsert: { key, kind, params, state: "PENDING", createdAt: Date.now(), updatedAt: Date.now() } },
+        { upsert: true, new: true }
+      );
+    try {
+      return plain(await create()) as Operation;
+    } catch (err: any) {
+      // Two workers upserting the same new key at once: one gets a duplicate key error. Read the winner.
+      if (err?.code === 11000) return plain(await OperationModel.findOne({ key })) as Operation;
+      throw err;
+    }
+  },
+  async get(key: string) {
+    return plain(await OperationModel.findOne({ key }));
+  },
+  async lease(key: string, now: number, ttlMs: number) {
+    const doc = await OperationModel.findOneAndUpdate(
+      { key, state: { $nin: TERMINAL }, $or: [{ leaseUntil: { $lte: now } }, { leaseUntil: { $exists: false } }] },
+      { $set: { leaseUntil: now + ttlMs } },
+      { new: true }
+    );
+    return plain(doc);
+  },
+  async transition(key: string, from: OpState, patch: Partial<Operation>) {
+    const doc = await OperationModel.findOneAndUpdate({ key, state: from }, { $set: patch }, { new: true });
+    return !!doc;
+  },
+  async release(key: string) {
+    await OperationModel.updateOne({ key }, { $set: { leaseUntil: 0 } });
+  },
+  async listOpen(now: number, limit: number) {
+    const docs = await OperationModel.find({ state: { $nin: TERMINAL }, leaseUntil: { $lte: now } })
+      .sort({ updatedAt: 1 })
+      .limit(limit);
+    return docs.map((d: any) => plain(d) as Operation);
+  },
+  async markRefunded(key: string) {
+    const doc = await OperationModel.findOneAndUpdate({ key, refunded: { $ne: true } }, { $set: { refunded: true } });
+    return !!doc;
+  },
+  async listUnfollowed(limit: number) {
+    const docs = await OperationModel.find({
+      state: { $in: TERMINAL },
+      followedUp: { $ne: true },
+      "params.next": { $exists: true },
+    }).limit(limit);
+    return docs.map((d: any) => plain(d) as Operation);
+  },
+  async markFollowed(key: string) {
+    const doc = await OperationModel.findOneAndUpdate({ key, followedUp: { $ne: true } }, { $set: { followedUp: true } });
+    return !!doc;
+  },
+};
diff --git a/src/services/ops/types.ts b/src/services/ops/types.ts
new file mode 100644
index 0000000..79f71ce
--- /dev/null
+++ b/src/services/ops/types.ts
@@ -0,0 +1,95 @@
+import { InputsCheck, PaymentCheck } from "../../wallet/kaspa.service";
+
+export type OpKind = "PAYOUT" | "BILL";
+
+/**
+ * PAYOUT: PENDING -> SIGNED -> CONFIRMED | FAILED | NEEDS_REVIEW
+ * BILL:   PENDING -> CALLED -> DELIVERED | FAILED | NEEDS_REVIEW
+ * FAILED means "definitely did not happen", so refunds and retries are safe.
+ * NEEDS_REVIEW means a human decides. Nothing automatic ever pays or refunds from it.
+ */
+export type OpState = "PENDING" | "SIGNED" | "CALLED" | "CONFIRMED" | "DELIVERED" | "FAILED" | "NEEDS_REVIEW";
+
+export const TERMINAL: OpState[] = ["CONFIRMED", "DELIVERED", "FAILED", "NEEDS_REVIEW"];
+
+export interface Operation {
+  key: string; // idempotency key, unique
+  kind: OpKind;
+  state: OpState;
+  params: Record<string, any>; // payout: {fromWallet, toAddress, amountSompi (string)}; bill: provider specific
+  txids: string[];
+  inputs: string[];
+  providerRef?: string;
+  attempts: number;
+  leaseUntil?: number; // epoch ms, 0/undefined = free
+  lastError?: string;
+  refunded?: boolean;
+  followedUp?: boolean;
+  signedAt?: number;
+  updatedAt: number;
+  createdAt: number;
+}
+
+/** Storage with compare and swap semantics. Two workers can never both win a transition. */
+export interface OpStore {
+  /** Returns the existing operation for the key, or creates it. */
+  getOrCreate(key: string, kind: OpKind, params: Record<string, any>): Promise<Operation>;
+  get(key: string): Promise<Operation | null>;
+  /** Takes the lease if it is free or expired. Returns the operation when taken, null otherwise. */
+  lease(key: string, now: number, ttlMs: number): Promise<Operation | null>;
+  /** Applies a patch only if the state still equals `from`. Returns false if someone else moved it. */
+  transition(key: string, from: OpState, patch: Partial<Operation>): Promise<boolean>;
+  release(key: string): Promise<void>;
+  /** Non terminal operations whose lease is free or expired. */
+  listOpen(now: number, limit: number): Promise<Operation[]>;
+  /** Marks a refund as done exactly once. True only for the caller that flipped it. */
+  markRefunded(key: string): Promise<boolean>;
+  /** Terminal operations that carry follow up work (params.next) not yet dispatched. */
+  listUnfollowed(limit: number): Promise<Operation[]>;
+  /** Marks follow up as dispatched exactly once. */
+  markFollowed(key: string): Promise<boolean>;
+}
+
+/**
+ * Work to start when an operation ends in a given state, kept inside the operation itself so it
+ * survives crashes. Dispatch is idempotent because every follow up has its own stable key.
+ */
+export type FollowUp =
+  | { kind: "PAYOUT" | "BILL"; key: string; params: Record<string, any> }
+  | { kind: "CREDIT"; key: string; userId: string; sompi: string };
+export type FollowUps = Partial<Record<OpState, FollowUp>>;
+
+export interface Chain {
+  sendSompi(
+    fromWallet: string,
+    toAddress: string,
+    amountSompi: bigint,
+    hooks: { onBeforeSubmit: (i: { txid: string; inputs: string[] }) => Promise<void> }
+  ): Promise<{ txid: string; txids: string[] }>;
+  checkPayment(txid: string, toAddress: string, amountSompi: bigint): Promise<PaymentCheck>;
+  checkInputs(fromAddress: string, inputs: string[]): Promise<InputsCheck>;
+}
+
+export type ProviderResult = "DELIVERED" | "FAILED" | "PENDING";
+
+export interface BillProvider {
+  /** Pays the bill under a stable request id. Throws when the outcome is unknown (timeout). */
+  pay(requestId: string, params: Record<string, any>): Promise<ProviderResult>;
+  /** Asks the provider what happened to a request id. Throws or returns PENDING when still unknown. */
+  requery(requestId: string, params: Record<string, any>): Promise<ProviderResult>;
+}
+
+export interface EngineDeps {
+  store: OpStore;
+  chain: Chain;
+  provider?: BillProvider;
+  now?: () => number;
+  leaseMs?: number;
+  /** Time after signing before "not found and inputs unspent" is accepted as "never broadcast". */
+  settleMs?: number;
+  /** Called once when an operation becomes FAILED and money should go back. */
+  onRefund?: (op: Operation) => Promise<void>;
+  alert?: (message: string, op: Operation) => void;
+  /** Applies a CREDIT follow up exactly once (the ref makes it idempotent). */
+  credit?: (userId: string, sompi: bigint, ref: string) => Promise<unknown>;
+}
diff --git a/src/services/payments.ts b/src/services/payments.ts
new file mode 100644
index 0000000..2a29936
--- /dev/null
+++ b/src/services/payments.ts
@@ -0,0 +1,115 @@
+import { UserModel } from "../models/User";
+import { OperationModel } from "../models/Operation";
+import { kasToSompi, formatKas } from "../utils/sompi";
+import { currentMessageId } from "../utils/requestContext";
+import { ledger } from "./ledger.mongo";
+import { engine } from "./ops";
+import { checkLimits, readLimits } from "./limits";
+import { TERMINAL, Operation } from "./ops/types";
+
+export type PaymentOutcome =
+  | { status: "DONE"; op: Operation }
+  | { status: "PENDING"; op: Operation } // outcome not known yet, the reconciler will settle it
+  | { status: "REJECTED"; reason: "INSUFFICIENT" | "FAILED"; message?: string };
+
+/** True while a user has money moving that has not been settled. Balance sync must not touch such users. */
+export async function hasOpenOperations(userId: string): Promise<boolean> {
+  const hit = await OperationModel.exists({ "params.refundUserId": userId, state: { $nin: TERMINAL } });
+  return !!hit;
+}
+
+/**
+ * KAS from a user's wallet to any address, exactly once per message.
+ * The balance is reduced first (once), the payment runs as a logged operation, and the balance is
+ * restored only if the payment is proven not to have left.
+ */
+export async function sendFromUser(user: any, toAddress: string, kas: number | string): Promise<PaymentOutcome> {
+  const sompi = kasToSompi(kas);
+  const key = `send:${user._id}:${currentMessageId()}`;
+
+  // Withdrawal limits cap the damage if an account is taken over. A retry of the same message is exempt.
+  const already = await engine_getExisting(key);
+  if (!already) {
+    const since = Date.now() - 24 * 3600 * 1000;
+    const recent: any[] = await OperationModel.find({
+      kind: "PAYOUT", "params.refundUserId": String(user._id), createdAt: { $gte: since }, state: { $ne: "FAILED" },
+      key: /^send:/,
+    }).select("params.amountSompi");
+    const sentToday = recent.reduce((sum, o) => sum + BigInt(o.params?.amountSompi || "0"), 0n);
+    const verdict = checkLimits(sompi, sentToday, readLimits());
+    if (!verdict.ok) {
+      const which = verdict.reason === "PER_TX" ? "per transaction" : "24 hour";
+      return { status: "REJECTED", reason: "FAILED", message: `This is above your ${which} send limit of ${formatKas(verdict.limitSompi)} KAS.` };
+    }
+  }
+  const debit = await ledger.debit(String(user._id), sompi, `debit:${key}`);
+  if (debit === "INSUFFICIENT") return { status: "REJECTED", reason: "INSUFFICIENT" };
+
+  const op = await engine.execute(key, "PAYOUT", {
+    fromWallet: `user:${user._id}`,
+    fromAddress: user.walletAddress || user.wallet,
+    toAddress,
+    amountSompi: sompi.toString(),
+    refundUserId: String(user._id),
+    refundSompi: sompi.toString(),
+  });
+  if (op.state === "CONFIRMED") return { status: "DONE", op };
+  if (op.state === "FAILED") return { status: "REJECTED", reason: "FAILED", message: op.lastError };
+  return { status: "PENDING", op };
+}
+
+/** Pays a Naira bill in KAS: user to operator on chain, then the provider, with an on chain refund if the provider fails. */
+export async function payBillFromUser(
+  user: any,
+  requiredKas: number,
+  bill: Record<string, any>
+): Promise<PaymentOutcome> {
+  const operator = process.env.OPERATOR_WALLET_ADDRESS || "";
+  if (!operator) return { status: "REJECTED", reason: "FAILED", message: "Payments are temporarily unavailable." };
+  const sompi = kasToSompi(requiredKas);
+  const base = `billkas:${user._id}:${currentMessageId()}`;
+
+  const debit = await ledger.debit(String(user._id), sompi, `debit:${base}`);
+  if (debit === "INSUFFICIENT") return { status: "REJECTED", reason: "INSUFFICIENT" };
+
+  const refundLeg = {
+    kind: "PAYOUT" as const,
+    key: `${base}:refund`,
+    params: {
+      fromWallet: "operator",
+      fromAddress: operator,
+      toAddress: user.walletAddress || user.wallet,
+      amountSompi: sompi.toString(),
+      next: { CONFIRMED: { kind: "CREDIT" as const, key: `credit:${base}:refund`, userId: String(user._id), sompi: sompi.toString() } },
+    },
+  };
+  const billLeg = { kind: "BILL" as const, key: `${base}:bill`, params: { ...bill, next: { FAILED: refundLeg } } };
+
+  const pay = await engine.execute(`${base}:pay`, "PAYOUT", {
+    fromWallet: `user:${user._id}`,
+    fromAddress: user.walletAddress || user.wallet,
+    toAddress: operator,
+    amountSompi: sompi.toString(),
+    refundUserId: String(user._id), // leg one failing means the money never left: restore the balance
+    refundSompi: sompi.toString(),
+    next: { CONFIRMED: billLeg },
+  });
+  if (pay.state === "FAILED") return { status: "REJECTED", reason: "FAILED", message: pay.lastError };
+  if (pay.state !== "CONFIRMED") return { status: "PENDING", op: pay };
+
+  const billOp = (await engine.execute(billLeg.key, "BILL", billLeg.params)) as Operation;
+  if (billOp.state === "DELIVERED") return { status: "DONE", op: billOp };
+  if (billOp.state === "FAILED") return { status: "REJECTED", reason: "FAILED", message: "The provider could not complete the payment. Your KAS is being returned to your wallet." };
+  return { status: "PENDING", op: billOp };
+}
+
+export async function freshBalanceKas(userId: string): Promise<string> {
+  const u: any = await UserModel.findById(userId);
+  const { userBalanceSompi } = await import("../utils/balance");
+  return u ? formatKas(userBalanceSompi(u), 4) : "0.0000";
+}
+
+
+async function engine_getExisting(key: string): Promise<boolean> {
+  return !!(await OperationModel.exists({ key }));
+}
