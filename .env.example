# ==========================================
# KASAPP SETUP FILE (TEMPLATE)
# Fill in your own details and save as .env
# ==========================================


# --- App Settings ---
PORT=3000
NODE_ENV=production


# --- Database ---
# Your MongoDB connection link goes here
MONGO_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/kasapp"


# --- Kaspa Network ---
# Use "mainnet" for real KAS, or switch to testnet for testing
KASPA_NETWORK=mainnet
# Optional: Add a custom Kaspa node URL here if you have one
# KASPA_RPC_URL="127.0.0.1:16110"


# --- Security Passwords ---
# Make up a long, random password here to safely lock up user wallets in the database
ENCRYPTION_KEY="put_a_long_random_secret_password_here"


# The 4-digit master PIN needed to approve large transfers (10,000 KAS or more)
ARGENT_MASTER_PIN="1234"


# --- Merchant Connections ---
# Make up a secret key that stores and merchants will use to connect to your app
MERCHANT_API_KEY="put_another_random_secret_password_here"


# --- WhatsApp Bot (Optional) ---
# WHATSAPP_API_TOKEN="your_whatsapp_token_here"


