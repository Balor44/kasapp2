# Copy this file to .env and replace EVERY value below.
# Values that still look like placeholders (your_..., change_me_...) make the server refuse to start.
# Generate strong secrets with:  openssl rand -hex 32


# Server
PORT=3000
NODE_ENV=production
# Comma separated list of websites allowed to call the public API from a browser.
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com


# Database and cache
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/kasapp
REDIS_URL=redis://default:<password>@redis-host:6379


# Kaspa network: mainnet, or a testnet such as testnet-10.
# The app checks that the connected node is on this same network and refuses to run if not.
KASPA_NETWORK=mainnet
KASPA_PRIORITY_FEE_SOMPI=10000


# Core security
# WARNING: ENCRYPTION_KEY protects every stored seed phrase. Back it up. If you change it,
# existing wallets can no longer be decrypted.
ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_32
ADMIN_API_KEY=change_me_generate_with_openssl_rand_hex_32
MERCHANT_API_KEY=change_me_generate_with_openssl_rand_hex_32
# Second factor for redeeming vouchers of 10,000 KAS or more through the merchant API.
ARGENT_MASTER_PIN=change_me_choose_a_private_pin


# Operator wallet (pays out vouchers, receives KAS for bill payments, sends refunds)
OPERATOR_WALLET_ADDRESS=kaspa:change_me_operator_wallet_address
# Plain 12 or 24 word phrase, or an encrypted value produced by the app. Never commit the real one.
OPERATOR_WALLET_MNEMONIC=change_me_operator_seed_phrase
# Alternative: store it encrypted instead (format iv:tag:hex)
# OPERATOR_ENCRYPTED_MNEMONIC=iv:tag:hex


# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change_me_verify_token
WHATSAPP_APP_SECRET=change_me_app_secret
WHATSAPP_ACCESS_TOKEN=change_me_access_token
WHATSAPP_PHONE_NUMBER_ID=change_me_phone_number_id
WHATSAPP_BOT_NUMBER=2348000000000
ADMIN_PHONE=+234...


# AI intent parser (Groq)
GROQ_API_KEY=change_me_groq_key
# GROQ_MODEL=openai/gpt-oss-20b


# Utility payment providers
# Live URL below is for mainnet. When KASPA_NETWORK is a testnet the server refuses to start unless
# you use the sandbox: VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_BASE_URL=https://vtpass.com/api
VTPASS_API_KEY=change_me
VTPASS_PUBLIC_KEY=change_me
VTPASS_SECRET_KEY=change_me
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-key-here


# Paystack (voucher purchases and webhook)
PAYSTACK_SECRET_KEY=sk_test_your_key_here
