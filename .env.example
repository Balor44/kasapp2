# =============================================================================
# KASAPP ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate with your environment credentials
# =============================================================================


# --- 1. Server Configuration ---
PORT=3000
NODE_ENV=production


# --- 2. Database (Mongoose) ---
# Standardized connection string (matches connectDB / server.ts requirements)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/kasapp?retryWrites=true&w=majority"


# Optional Redis Cache / Session Store (if enabled)
REDIS_URL="redis://default:<password>@<host>:<port>"


# --- 3. Security & Cryptography ---
# 32-byte hex or high-entropy passphrase for AES mnemonic/seed encryption
ENCRYPTION_KEY="replace_with_a_secure_random_32_byte_secret_key"


# 2FA PIN for high-value vault / covenant threshold unlocks (>= 10,000 KAS)
ARGENT_MASTER_PIN="1234"


# Secret token for authenticating merchant API endpoints
MERCHANT_API_KEY="replace_with_merchant_api_secret_key"


# --- 4. Kaspa Blockchain Node & Wallet Settings ---
# Network selection: "mainnet", "testnet-10", or "testnet-11"
KASPA_NETWORK=mainnet


# Optional custom node RPC endpoint (defaults to public resolvers if omitted)
# KASPA_RPC_URL="127.0.0.1:16110"


# Priority fee in Sompi (1 KAS = 100,000,000 Sompi). 10000 Sompi = 0.0001 KAS
KASPA_PRIORITY_FEE_SOMPI="10000"


# Operator / Hot Vault Settings (used for escrows and utility settlements)
OPERATOR_WALLET_ADDRESS="kaspa:qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq"
OPERATOR_MNEMONIC="twelve word secret recovery seed phrase for hot vault operator here"
# OPERATOR_ENCRYPTED_MNEMONIC=""


# --- 5. Meta WhatsApp Cloud API ---
WHATSAPP_TOKEN="EAAB..."
WHATSAPP_ACCESS_TOKEN="EAAB..."
WHATSAPP_PHONE_NUMBER_ID="123456789012345"
WHATSAPP_VERIFY_TOKEN="your_webhook_verification_token"
WHATSAPP_APP_SECRET="your_meta_app_secret_for_x_hub_signature_verification"


# --- 6. AI Intent Engine (Groq / OpenAI SDK) ---
GROQ_API_KEY="gsk_..."
GROQ_MODEL="llama-3.3-70b-versatile"


# --- 7. Fiat & Utility Integrations ---
# Paystack (Checkout & Fiat On-Ramp)
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PUBLIC_KEY="pk_test_..."


# VTPass (Airtime, Data, Electricity, Cable TV)
VTPASS_API_KEY=""
VTPASS_SECRET_KEY=""
VTPASS_PUBLIC_KEY=""


# Optional: Flutterwave fallback
FLW_PUBLIC_KEY="FLWPUBK-..."
FLW_SECRET_KEY="FLWSECK-..."
FLW_ENCRYPTION_KEY=""


