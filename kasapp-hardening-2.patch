+    if (options.requireSynced && !info.isSynced) {
+      throw new Error("The connected Kaspa node is still syncing. Please try again in a moment.");
+    }
+
+    return rpc;
+  } catch (err) {
+    try {
+      await rpc.disconnect();
+    } catch {}
+    throw err;
+  }
+}
